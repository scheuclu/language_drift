# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# precomputed data lives on Vercel Blob (see lib/data-source.ts), NOT in git.
# Regenerate via scripts/precompute_*.py, pack with scripts/pack_web_data.py,
# then upload packed/ + manifest/arith/space to Blob under data/vN/.
/public/data/

# dev server log
dev.log

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
